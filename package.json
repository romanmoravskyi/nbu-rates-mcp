{
  "name": "nbu-rates-mcp",
  "version": "0.1.0",
  "description": "Self-hosted MCP server for official NBU (National Bank of Ukraine) exchange rates, in plain Node.js",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Roman Moravskyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/romanmoravskyi/nbu-rates-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "main": "dist/index.js"
}
